// Search implementation
func (t *CRMTools) searchGlobal(ctx context.Context, req *mcp.CallToolRequest, args searchArgs) (*mcp.CallToolResult, error) {
	actor := mcpAuthContext()
	opts := search.SearchOptions{
		Query:     args.Query,
		Limit:     args.Limit,
		Workspace: actor.WorkspaceID,
	}
	resp, err := t.searchSvc.Search(ctx, opts)
	if err != nil {
		return handleError(err), nil, err
	}
	return &mcp.CallToolResult{StructuredContent: map[string]any{"results": resp.Results}}, nil
}

// Argument structs for typed handlers
type listCompaniesArgs struct {
	Query  string `json:"query,omitempty"`
	Status string `json:"status,omitempty"`
	Limit  int    `json:"limit,omitempty"`
	Offset int    `json:"offset,omitempty"`
	Sort   string `json:"sort,omitempty"`
	Order  string `json:"order,omitempty"`
}

type listContactsArgs struct {
	Query  string `json:"query,omitempty"`
	Status string `json:"status,omitempty"`
	Limit  int    `json:"limit,omitempty"`
	Offset int    `json:"offset,omitempty"`
}

type listLeadsArgs struct {
	Query  string `json:"query,omitempty"`
	Status string `json:"status,omitempty"`
	Limit  int    `json:"limit,omitempty"`
	Offset int    `json:"offset,omitempty"`
}

type listDealsArgs struct {
	Query  string `json:"query,omitempty"`
	Limit  int    `json:"limit,omitempty"`
	Offset int    `json:"offset,omitempty"`
}

type listTasksArgs struct {
	Query   string `json:"query,omitempty"`
	Status  string `json:"status,omitempty"`
	Limit   int    `json:"limit,omitempty"`
	Offset  int    `json:"offset,omitempty"`
}

type listProjectsArgs struct {
	Query  string `json:"query,omitempty"`
	Status string `json:"status,omitempty"`
	Limit  int    `json:"limit,omitempty"`
	Offset int    `json:"offset,omitempty"`
}

type listDealsArgs struct {
	Query  string `json:"query,omitempty"`
	Limit  int    `json:"limit,omitempty"`
	Offset int    `json:"offset,omitempty"`
}

type getEntityArgs struct {
	ID string `json:"id"`
}

type searchArgs struct {
	Query  string `json:"query"`
	Limit  int    `json:"limit,omitempty"`
}

// Helpers
func mcpAuthContext() permissions.AuthContext {
	return permissions.AuthContext{
		ActorType:   "agent",
		ActorID:     "mcp-agent",
		WorkspaceID: "ws_default",
		Scopes:      []string{"companies:read", "companies:write", "contacts:read", "contacts:write", "leads:read", "leads:write", "deals:read", "deals:write", "tasks:read", "tasks:write", "projects:read", "projects:write", "emails:read", "emails:send", "audit:read"},
	}
}

func handleError(err error) *mcp.CallToolResult {
	if err == nil {
		return &mcp.CallToolResult{}
	}
	return &mcp.CallToolResult{IsError: true, Content: []mcp.Content{&mcp.TextContent{Text: err.Error()}}}
}