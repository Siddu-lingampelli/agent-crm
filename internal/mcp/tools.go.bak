// Company implementations
func (t *CRMTools) listCompanies(ctx context.Context, req *mcp.CallToolRequest, args listCompaniesArgs) (result *mcp.CallToolResult, output map[string]any, err error) {
	actor := mcpAuthContext()
	in := companies.ListInput{
		Query:  args.Query,
		Status: args.Status,
		Limit:  args.Limit,
		Offset: args.Offset,
		Sort:   args.Sort,
		Order:  args.Order,
	}
	page, err := t.companySvc.List(ctx, actor, in)
	if err != nil {
		return handleError(err), nil, err
	}
	return return &mcp.CallToolResult{StructuredContent: map[string]any{"companies": page.Items, "total": page.Total}}, nilmcp.CallToolResult{StructuredContent: map[string]any{"companies": page.Items, "total": page.Total}}, map[string]any{"companies": page.Items, "total": page.Total}, nil
}

func (t *CRMTools) getCompany(ctx context.Context, req *mcp.CallToolRequest, args getEntityArgs) (*mcp.CallToolResult, error) {
	actor := mcpAuthContext()
	company, err := t.companySvc.Get(ctx, actor, args.ID)
	if err != nil {
		return handleError(err), nil, err
	}
	return &mcp.CallToolResult{StructuredContent: map[string]any{"company": company}}, nil
}

func (t *CRMTools) createCompany(ctx context.Context, req *mcp.CallToolRequest, args companies.CreateInput) (*mcp.CallToolResult, error) {
	actor := mcpAuthContext()
	company, err := t.companySvc.Create(ctx, actor, args)
	if err != nil {
		return handleError(err), nil, err
	}
	return &mcp.CallToolResult{StructuredContent: map[string]any{"company": company}}, nil
}

func (t *CRMTools) updateCompany(ctx context.Context, req *mcp.CallToolRequest, args companies.UpdateInput) (*mcp.CallToolResult, error) {
	actor := mcpAuthContext()
	company, err := t.companySvc.Update(ctx, actor, args.ID, args)
	if err != nil {
		return handleError(err), nil, err
	}
	return &mcp.CallToolResult{StructuredContent: map[string]any{"company": company}}, nil
}

func (t *CRMTools) archiveCompany(ctx context.Context, req *mcp.CallToolRequest, args getEntityArgs) (*mcp.CallToolResult, error) {
	actor := mcpAuthContext()
	if err := t.companySvc.Archive(ctx, actor, args.ID); err != nil {
		return handleError(err), nil, err
	}
	return &mcp.CallToolResult{Content: []mcp.Content{&mcp.TextContent{Text: "Company archived"}}}, nil
}

